# For local development — uses a local SQLite file, no cloud needed
TURSO_DATABASE_URL=file:./data/cards.db
TURSO_AUTH_TOKEN=

# For production (Turso cloud) — replace these after running `turso db create cardsfortheoccasion`
# TURSO_DATABASE_URL=libsql://cardsfortheoccasion-<your-org>.turso.io
# TURSO_AUTH_TOKEN=<token from `turso db tokens create cardsfortheoccasion`>

# Vercel Blob — set automatically when you add a Blob store in Vercel dashboard
# For local dev: copy from Vercel dashboard → Storage → your Blob store → .env.local tab
BLOB_READ_WRITE_TOKEN=
